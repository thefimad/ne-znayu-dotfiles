#!/usr/bin/env python3
"""Mirror the Hyprland palette into ~/.config/quickshell/core/Theme.qml.

colors.lua stays the single source of truth; this script regexes its hex
literals and regenerates the QML singleton so bar and borders cannot drift.
Run it after editing colors.lua.
"""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

HOME = Path.home()
SOURCE = HOME / ".config/hypr/modules/colors.lua"
OUTPUT = HOME / ".config/quickshell/core/Theme.qml"

TOKENS = [
    "bg0",
    "bg1",
    "bg2",
    "line",
    "lineStrong",
    "ink",
    "inkDim",
    "cream",
    "amber",
]

ENTRY = re.compile(r'^\s*([A-Za-z0-9_]+)\s*=\s*"#([0-9A-Fa-f]{6})"\s*,?\s*$')

TEMPLATE = """// GENERATED by ~/.local/bin/theme-sync from ~/.config/hypr/modules/colors.lua
// Do not edit by hand. Change the palette in colors.lua and re-run theme-sync.
pragma Singleton

import QtQuick

QtObject {{
{properties}

    readonly property string mono: "JetBrains Mono"
    readonly property int radius: 0
    readonly property int borderWidth: 1
}}
"""


def main() -> int:
    if not SOURCE.exists():
        print(f"theme-sync: missing {SOURCE}", file=sys.stderr)
        return 1

    colors: dict[str, str] = {}
    for line in SOURCE.read_text(encoding="utf-8").splitlines():
        match = ENTRY.match(line)
        if match:
            name, value = match.groups()
            colors[name] = value.lower()

    missing = [token for token in TOKENS if token not in colors]
    if missing:
        print(f"theme-sync: colors.lua is missing {', '.join(missing)}", file=sys.stderr)
        return 1

    width = max(len(token) for token in TOKENS)
    properties = "\n".join(
        f'    readonly property color {token.ljust(width)}: "#{colors[token]}"'
        for token in TOKENS
    )

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(TEMPLATE.format(properties=properties), encoding="utf-8")
    print(f"theme-sync: wrote {OUTPUT}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
